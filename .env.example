# Copy to .env.local — safe to expose in the browser (publishable key + project URL).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional: show Glute day routine only for this auth user id (Skills is visible to everyone).
NEXT_PUBLIC_PERSONAL_GLUTES_USER_ID=
